{
  "expo": {
    "name": "GastroLab",
    "slug": "gastrolab",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "gastrolab",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "GastroLab necesita acceso a tus fotos para seleccionar imágenes de tus recetas."
        }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
